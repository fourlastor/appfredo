    <string name="how_title">How I work</string>
    <string name="how_source_title">Straight from the maker</string>
    <string name="how_source_body">Apps arrive from the GitHub releases you choose. No middlemen, no accounts.</string>
    <string name="how_fresh_title">Kept fresh</string>
    <string name="how_fresh_body">When an update lands, I fetch only the bits that changed. Smaller downloads, same app.</string>
    <string name="how_rules_title">Your rules</string>
