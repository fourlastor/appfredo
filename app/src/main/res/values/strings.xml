    <!-- About -->
    <string name="about_title">Appfredo, at your service.</string>
    <string name="about_body">I keep a personal collection of Android apps, fetched from the public GitHub releases you choose.</string>
    <string name="about_makers_title">For app makers</string>
    <string name="about_makers_body">Attach an appfredo.json manifest and a signed APK to a stable release. Add Wharf patches and updates shrink to a fraction of the size. If a patch won’t apply, I quietly fetch the full APK instead.</string>
    <string name="about_limits_title">Not on the menu yet</string>
    <string name="about_limits_body">Pre-releases, split APKs and automatic checks. For now, pull down on your library and I’ll take another look.</string>
    <string name="about_version">Version %s</string>
    <string name="about_fonts">Set in Fraunces and Figtree, under the SIL Open Font License.</string>
